# ============================================
# OpenAI Configuration
# ============================================
OPENAI_API_KEY=your_openai_api_key_here

# Model: gpt-4o-mini (cheapest & fast for RAG responses)
NEXT_PUBLIC_OPENAI_MODEL=gpt-4o-mini

# ============================================
# PostgreSQL Configuration
# ============================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=chatbot_db

# Full connection string (sesuaikan dengan kredensial di atas)
DATABASE_URL=postgresql://postgres:your_postgres_password_here@localhost:5433/chatbot_db

# ============================================
# Application Configuration
# ============================================
PORT=3001
NODE_ENV=production
NEXT_PUBLIC_APP_NAME="Sontoloyo AI"
NEXT_PUBLIC_SITE_URL=https://chat.adi-muhamad.my.id

# ============================================
# Cloudflare Tunnel Configuration
# ============================================
CLOUDFLARE_TUNNEL_ID=your_cloudflare_tunnel_id_here

# ============================================
# Cloudflare Turnstile Bot Detection (/admin)
# ============================================
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key_here
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here

# ============================================
# Admin Console Credentials
# ============================================
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_strong_admin_password
ADMIN_SESSION_SECRET=your_random_session_secret

# ============================================
# RAG Configuration
# ============================================
# Top K documents to retrieve from vector similarity search
NEXT_PUBLIC_RAG_TOP_K=5

# Embedding model (for ingest-postgres.js & Web UI embedding)
NEXT_PUBLIC_EMBEDDING_MODEL=text-embedding-3-small

# ============================================
# Chat Configuration
# ============================================
NEXT_PUBLIC_SYSTEM_PROMPT="Anda adalah asisten personal blog yang helpful dan friendly. Gunakan informasi dari konteks yang diberikan untuk memberikan jawaban yang akurat dan relevan. Jangan menjawab hal di luar konteks yang ada di database vektor."

# Max tokens untuk response
NEXT_PUBLIC_MAX_TOKENS=1000

# Temperature (0.0 = deterministic, 1.0 = creative)
NEXT_PUBLIC_TEMPERATURE=0.7
